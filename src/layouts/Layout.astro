---
import '@fontsource-variable/manrope';
import '@fontsource-variable/syne';
import '@fontsource-variable/vazirmatn';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import type { Direction, Locale } from '../data/portfolio';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  htmlLocale: string;
  direction: Direction;
  openGraphLocale: string;
  canonicalPath: '/' | '/fa/';
  image: string;
}

const {
  title,
  description,
  locale,
  htmlLocale,
  direction,
  openGraphLocale,
  canonicalPath,
  image,
} = Astro.props;

const site = Astro.site ?? new URL('https://mahdim43.github.io');
const canonical = new URL(canonicalPath, site);
const englishUrl = new URL('/', site);
const persianUrl = new URL('/fa/', site);
const imageUrl = new URL(image, site);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: locale === 'fa' ? 'مهدی هوشمند' : 'Mahdi Hooshmand',
  alternateName: locale === 'fa' ? 'Mahdi Hooshmand' : 'مهدی هوشمند',
  jobTitle: locale === 'fa' ? 'متخصص سیستم و زیرساخت' : 'Systems & Infrastructure Specialist',
  url: canonical.href,
  email: 'mailto:hooshmandm43@gmail.com',
  sameAs: [
    'https://github.com/mahdim43',
    'https://www.linkedin.com/in/mahdi-hooshmand',
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: locale === 'fa' ? 'مشهد' : 'Mashhad',
    addressCountry: 'IR',
  },
  knowsAbout: ['Systems Administration', 'Network Infrastructure', 'VMware', 'VoIP', 'Odoo ERP'],
};
---

<!doctype html>
<html lang={htmlLocale} dir={direction} data-locale={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0e10" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="fa" href={persianUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content={openGraphLocale} />
    <meta property="og:site_name" content="Mahdi Hooshmand" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <slot />
  </body>
</html>
