---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found — Mahdi Hooshmand"
  description="The requested page could not be found."
  locale="en"
  htmlLocale="en"
  direction="ltr"
  openGraphLocale="en_US"
  canonicalPath="/"
  image="/og/portfolio-en.png"
>
  <main class="error-page">
    <div class="container error-content">
      <p>ROUTE / 404</p>
      <h1>Signal lost.</h1>
      <span>The requested page is outside this topology.</span>
      <a href="/">Return home →</a>
    </div>
  </main>
</Layout>

<style>
  .error-page { min-height: 100vh; display: grid; place-items: center; }
  .error-content { max-width: 760px; }
  p { color: var(--copper); font: 400 10px/1 var(--font-mono); letter-spacing: .12em; }
  h1 { margin: 24px 0 8px; font: 650 clamp(64px,12vw,140px)/.9 var(--font-display); letter-spacing: -.06em; }
  span { display: block; color: var(--muted); font-size: 18px; }
  a { display: inline-block; margin-block-start: 40px; padding: 12px 18px; color: var(--ink); background: var(--copper-bright); font-weight: 800; }
</style>
